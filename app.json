{
  "expo": {
    "name": "Saakshi",
    "slug": "saakshi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "saakshi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.aayushtainwala.saakshi",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      },
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "in.aayushtainwala.saakshi"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "Saakshi uses the camera to record photos and videos for your own records. They are fingerprinted and signed on your phone.",
          "microphonePermission": "Saakshi records sound with your videos and in bug mode, for your own records.",
          "recordAudioAndroid": true,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Saakshi adds where you are to the record of each photo and video, to the alerts you send your trusted contacts, and to live location while you share it.",
          "locationAlwaysAndWhenInUsePermission": "Saakshi uses your location only while you share live location with your trusted contacts. It never tracks you otherwise.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Saakshi records sound with your videos and in bug mode, for your own records.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "./modules/saakshi-sos/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7baf841e-820d-423e-a69b-6f813010fe02"
      }
    },
    "locales": {
      "en": "./src/i18n/native/en.json",
      "hi": "./src/i18n/native/hi.json"
    }
  }
}
