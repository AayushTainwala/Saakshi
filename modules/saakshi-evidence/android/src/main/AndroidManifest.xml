<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Body-cam mode: keep recording video and sound with the screen off (spec B1–B4). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- Android 13+: the recording notice with its Stop button. Asked the first time body-cam starts. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

  <application>
    <service
      android:name="expo.modules.saakshievidence.BodyCamService"
      android:exported="false"
      android:foregroundServiceType="camera|microphone" />
  </application>
</manifest>
