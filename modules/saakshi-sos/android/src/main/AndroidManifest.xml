<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- SEND_SMS is added by app.plugin.js only when SAAKSHI_SMS_AUTOSEND=1 at prebuild (the APK). -->

  <!-- Quick trigger (spec S4): the optional notification, shown again after a restart. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Bug mode (spec E8): record sound with the screen locked. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.saakshisos.BugModeService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Home-screen widget that opens the code pad. -->
    <receiver
      android:name="expo.modules.saakshisos.QuickWidgetProvider"
      android:exported="true"
      android:label="@string/saakshi_quick_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/saakshi_quick_widget_info" />
    </receiver>

    <receiver
      android:name="expo.modules.saakshisos.QuickBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
