<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- SEND_SMS is added by app.plugin.js only when SAAKSHI_SMS_AUTOSEND=1 at prebuild (the APK). -->

  <!-- Quick trigger (spec S4): the optional notification, shown again after a restart. -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

  <!-- Bug mode (spec E8): record sound with the screen locked. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />

  <application>
    <service
      android:name="expo.modules.saakshisos.BugModeService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

    <!-- Home-screen widget that opens the code pad. -->
    <receiver
      android:name="expo.modules.saakshisos.QuickWidgetProvider"
      android:exported="true"
      android:label="@string/saakshi_quick_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/saakshi_quick_widget_info" />
    </receiver>

    <!--
      "Lock the phone when 'My phone is being taken' starts" (SPEC 5.4; round 2, group 1.7): device
      admin with the force-lock policy only, switched on by the user. BIND_DEVICE_ADMIN here is the
      permission a sender needs (only the system holds it); Saakshi requests no permission for this.
      Keep the receiver's name: Android switches the admin off if it changes in an update.
    -->
    <receiver
      android:name="expo.modules.saakshisos.LockAdminReceiver"
      android:description="@string/saakshi_lock_admin_description"
      android:exported="true"
      android:permission="android.permission.BIND_DEVICE_ADMIN">
      <meta-data
        android:name="android.app.device_admin"
        android:resource="@xml/saakshi_lock_admin" />
      <intent-filter>
        <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
      </intent-filter>
    </receiver>

    <receiver
      android:name="expo.modules.saakshisos.QuickBootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
      </intent-filter>
    </receiver>
  </application>
</manifest>
